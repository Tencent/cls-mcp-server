{
  "name": "cls-mcp-server",
  "version": "1.3.0",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "bin": {
    "cls-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "webpack && chmod 755 dist/index.js",
    "lint": "eslint -c .eslintrc.js --quiet \"src/**/*.ts\"",
    "prepare": "husky",
    "prepublishOnly": "node scripts/prepare-readme.js",
    "postpublish": "node scripts/restore-readme.js",
    "publish:npm": "npm i && npm run build && npm publish --registry=\"https://registry.npmjs.org/\"",
    "start": "npm run build && node ./dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Tencent/cls-mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tencent/cls-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/Tencent/cls-mcp-server/issues"
  },
  "description": "",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "tencentcloud-sdk-nodejs-cls": "^4.1.331",
    "tencentcloud-sdk-nodejs-common": "^4.1.220",
    "tencentcloud-sdk-nodejs-region": "^4.1.328",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@types/express": "^5.0.1",
    "@types/ip": "^1.1.3",
    "@types/node": "^20.17.30",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/coverage-v8": "^4.1.12",
    "babel-eslint": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-tencent": "^1.2.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^3.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^2.8.8",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint -c .eslintrc.js --fix"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "minimatch@^10.2.2": "11.0.5",
    "uuid@^9.0.1": "11.1.1"
  },
  "packageManager": "npm@10.9.2"
}
